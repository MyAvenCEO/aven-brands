{
	"name": "@myavenceo/aven-brandkit",
	"version": "0.1.0",
	"type": "module",
	"description": "The machinery a brand is rendered by — tokens to CSS, a utility layer generated from the brand's own scales, a class scanner and the Vite step. Holds no colour, no typeface and no component of its own.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./generate": {
			"types": "./dist/generate.d.ts",
			"default": "./dist/generate.js"
		},
		"./utilities": {
			"types": "./dist/utilities.d.ts",
			"default": "./dist/utilities.js"
		},
		"./scan": {
			"types": "./dist/scan.d.ts",
			"default": "./dist/scan.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./kitchen-sink": {
			"types": "./dist/kitchen-sink.d.ts",
			"default": "./dist/kitchen-sink.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^26.3.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}

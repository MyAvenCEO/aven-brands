{
	"name": "site-footer",
	"description": "The legal footer. The website and the avenID service each wrote their own; the links are the same brand facts either way.",
	"interface": {
		"props": { "note": "string" },
		"slots": { "links": {} }
	},
	"layout": { "primitive": "stack", "gap": "space-comfortable" },
	"view": {
		"tag": "footer",
		"children": [
			{ "tag": "nav", "class": "site-footer-links", "$children": "links" },
			{ "tag": "p", "class": "site-footer-note", "text": "$props.note" }
		]
	},
	"styling": {
		"base": {
			"padding": "var(--space-section) 1.25rem",
			"borderTop": "1px solid var(--color-border)",
			"fontSize": "var(--fs-meta)",
			"color": "color-mix(in srgb, var(--color-foreground) 75%, transparent)"
		}
	}
}

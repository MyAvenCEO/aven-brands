{
	"name": "btn",
	"description": "The one button. Every affirmative, neutral and destructive action on every surface is this unit with a different variant.",
	"interface": {
		"props": {
			"label": "string",
			"type": "string",
			"disabled": "boolean",
			"busy": "boolean"
		},
		"events": {
			"press": { "id": "string" }
		}
	},
	"view": {
		"tag": "button",
		"attrs": {
			"type": "$props.type",
			"disabled": "$props.disabled",
			"aria-busy": "$props.busy"
		},
		"text": "$props.label"
	},
	"styling": {
		"interactive": true,
		"base": {
			"display": "inline-flex",
			"alignItems": "center",
			"justifyContent": "center",
			"gap": "var(--space-tight)",
			"minHeight": "2.75rem",
			"padding": "0 1.75rem",
			"border": "0",
			"borderRadius": "var(--radius-pill)",
			"background": "var(--color-primary)",
			"color": "var(--color-primary-foreground)",
			"font": "inherit",
			"fontSize": "var(--fs-section)",
			"fontWeight": "600",
			"cursor": "pointer",
			"transition": "opacity 0.15s ease, box-shadow 0.15s ease"
		},
		"variants": {
			"variant": {
				"primary": {
					"background": "var(--color-primary)",
					"color": "var(--color-primary-foreground)"
				},
				"secondary": {
					"background": "transparent",
					"color": "var(--color-foreground)",
					"boxShadow": "inset 0 0 0 1px var(--color-border)"
				},
				"danger": {
					"background": "var(--color-error)",
					"color": "var(--color-error-foreground)"
				},
				"ghost": {
					"background": "transparent",
					"color": "var(--color-foreground)"
				}
			},
			"size": {
				"sm": { "minHeight": "2.25rem", "padding": "0 1.25rem", "fontSize": "var(--fs-meta)" },
				"lg": { "minHeight": "3.5rem", "padding": "0 2.25rem", "fontSize": "var(--fs-lead)" }
			}
		},
		"states": {
			"hover": { "opacity": "0.9" },
			"focus": {
				"outline": "2px solid var(--color-accent-ink)",
				"outlineOffset": "2px"
			},
			"active": { "transform": "translateY(1px)" },
			"disabled": { "cursor": "default", "opacity": "0.55" },
			"loading": { "cursor": "progress", "opacity": "1" }
		}
	},
	"a11y": {
		"role": "button",
		"keyboard": "Enter and Space activate. Tab reaches it. Disabled removes it from the tab order.",
		"notes": "`loading` deliberately keeps full opacity and swaps the cursor: an action in flight must not read as unavailable. aria-busy carries the announcement."
	}
}

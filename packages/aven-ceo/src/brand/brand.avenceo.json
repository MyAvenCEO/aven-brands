{
	"$description": "avenCEO brand tokens. THE source of truth: the TypeScript package loads this file and adds types, it does not hold values. DTCG shape ($type/$value); values may reference other tokens with var(--color-...) exactly as the emitted CSS does.",
	"name": "avenCEO",
	"slug": "aven-ceo",
	"color": {
		"tones": {
			"marine": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "deep navy — the brand blue, the body copy and the dark ground. Absorbed `ink` (#182a47), which was the same hue two lightness steps away and carried only `foreground`."
			},
			"anchor": {
				"$type": "color",
				"$value": "#57789e",
				"$description": "the mid step of the marine hue — everything held back."
			},
			"terracotta": {
				"$type": "color",
				"$value": "#c15b40",
				"$description": "FUNCTIONAL, not identity: the failure tone. It is not in the logo and must not be used as a brand accent — it means something went wrong."
			},
			"sunflower": {
				"$type": "color",
				"$value": "#f2ba3d",
				"$description": "the brand highlight. Sunflower, not \"gold\" — the name is the brand's own and the generic one loses it."
			},
			"earth": {
				"$type": "color",
				"$value": "#d4a373",
				"$description": "FUNCTIONAL, not identity: the notice tone. Sits between terracotta and sunflower in hue and carries `info`."
			},
			"sand": {
				"$type": "color",
				"$value": "#f3e7c6",
				"$description": "the warmest step of the light ground, and the selected-card fill. A light step of the sunflower hue rather than a colour of its own."
			},
			"paradise": {
				"$type": "color",
				"$value": "#2489a0",
				"$description": "the deeper blue-teal — work in motion. Renamed from tidal-blue."
			},
			"turquoise": {
				"$type": "color",
				"$value": "#449c94",
				"$description": "the bright turquoise — settled work. Renamed from paradise-water."
			}
		},
		"creams": {
			"porcelain": {
				"$type": "color",
				"$value": "#fffdf7",
				"$description": "the raised card — lightest, lifts off the page"
			},
			"linen": {
				"$type": "color",
				"$value": "#faf9f4",
				"$description": "the page ground everything rests on"
			},
			"eggshell": {
				"$type": "color",
				"$value": "#f6f3e8",
				"$description": "one step warmer — panels, hover"
			},
			"ivory": {
				"$type": "color",
				"$value": "#f6f1e2",
				"$description": "warmest — cards at rest, and selection"
			},
			"chalk": {
				"$type": "color",
				"$value": "#f8fafc",
				"$description": "near-white with a blue cast — the ground a dark surface inverts to, and the text that reads on a filled tone."
			}
		},
		"contrastInk": {
			"on-warning": {
				"$type": "color",
				"$value": "#2b2313",
				"$description": "near-black with a warm cast — the only text that reads on sunflower."
			},
			"on-error": {
				"$type": "color",
				"$value": "#fffefb",
				"$description": "near-white with a warm cast — the text that reads on terracotta."
			},
			"on-success": {
				"$type": "color",
				"$value": "#fafaf9",
				"$description": "near-white, neutral — the text that reads on turquoise."
			},
			"on-info": {
				"$type": "color",
				"$value": "#2b231c",
				"$description": "near-black with a warm cast — the text that reads on earth."
			},
			"white": {
				"$type": "color",
				"$value": "#ffffff",
				"$description": "true white. The one place the system uses it, so it is named rather than typed."
			}
		},

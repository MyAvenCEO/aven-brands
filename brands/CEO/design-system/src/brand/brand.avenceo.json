{
	"$description": "avenCEO brand tokens. THE source of truth: the TypeScript package loads this file and adds types, it does not hold values. DTCG shape ($type/$value); values may reference other tokens with var(--color-...) exactly as the emitted CSS does.",
	"name": "avenCEO",
	"slug": "aven-ceo",
	"color": {
		"tones": {
			"$description": "The brand identity. Four hues, and nothing that only carries a meaning — a colour in here is one the logo and the marketing may use. Sorted by hue.",
			"marine": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "the brand blue. Also the ground the dark theme stands on."
			},
			"paradise": {
				"$type": "color",
				"$value": "#2489a0",
				"$description": "the deeper blue-teal — work in motion."
			},
			"turquoise": {
				"$type": "color",
				"$value": "#449c94",
				"$description": "the bright turquoise — settled work."
			},
			"sunflower": {
				"$type": "color",
				"$value": "#f2ba3d",
				"$description": "the highlight. Sunflower, not \"gold\" — the generic word loses the name."
			}
		},
		"functional": {
			"$description": "Colours that carry a MEANING and are never identity. Neither appears in the logo, and neither may be used as a brand accent — reaching for the failure tone to decorate something is the mistake this separation exists to prevent.",
			"terracotta": {
				"$type": "color",
				"$value": "#c15b40",
				"$description": "the failure pigment. Kept its own name: a TONE is named for the paint and a ROLE for the meaning, so `terracotta` and `error` are different words for a reason. It lives here rather than in `tones` because it is never identity — it appears in no logo and must not decorate."
			},
			"earth": {
				"$type": "color",
				"$value": "#d4a373",
				"$description": "the notice pigment. Same reasoning."
			}
		},
		"surfaces": {
			"$description": "Every surface a page stands on, in both themes. The LIGHT ladder is the sand family (the brand cream); the DARK ladder is the marine family. Named `<theme>-<rung>`, so a theme is a prefix and adding dark is adding rows. The dark ladder is declared and NOT yet wired — nothing renders from it until a theme selects it.",
			"light-page": {
				"$type": "color",
				"$value": "#fffdf7",
				"$description": "the page itself — the lightest sand."
			},
			"light-raised": {
				"$type": "color",
				"$value": "#faf9f4",
				"$description": "lifted off the page."
			},
			"light-sunken": {
				"$type": "color",
				"$value": "#f6f3e8",
				"$description": "set into the page."
			},
			"light-card": {
				"$type": "color",
				"$value": "#f6f1e2",
				"$description": "the fill of a card."
			},
			"light-selected": {
				"$type": "color",
				"$value": "#f3e7c6",
				"$description": "a card the user has chosen — sand at full strength."
			},
			"dark-page": {
				"$type": "color",
				"$value": "#161f30",
				"$description": "the page itself — marine, one step below the brand tone."
			},
			"dark-raised": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "lifted off the page — the brand marine."
			},
			"dark-sunken": {
				"$type": "color",
				"$value": "#131a28",
				"$description": "set into the page."
			},
			"dark-card": {
				"$type": "color",
				"$value": "#243448",
				"$description": "the fill of a card."
			},
			"dark-selected": {
				"$type": "color",
				"$value": "#3e4b60",
				"$description": "a card the user has chosen."
			}
		},
		"ink": {
			"$description": "Text guaranteed to read on a filled colour. Concrete values, not derivations: these used to be `color-mix(... N%, black)` computed at render time in seven places, which meant the system could not tell you what colour its own text was without a browser. Same rendered values, now nameable and checkable.",
			"on-light": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "on any light rung — the brand marine."
			},
			"on-dark": {
				"$type": "color",
				"$value": "#f8fafc",
				"$description": "on any dark rung."
			},
			"on-primary": {
				"$type": "color",
				"$value": "#f8fafc",
				"$description": "on marine."
			},
			"on-warning": {
				"$type": "color",
				"$value": "#2b2313",
				"$description": "on sunflower."
			},
			"on-error": {
				"$type": "color",
				"$value": "#fffefb",
				"$description": "on the failure tone."
			},
			"on-success": {
				"$type": "color",
				"$value": "#fafaf9",
				"$description": "on turquoise."
			},
			"on-info": {
				"$type": "color",
				"$value": "#2b231c",
				"$description": "on the notice tone."
			},
			"white": {
				"$type": "color",
				"$value": "#ffffff",
				"$description": "true white. Named because the system uses it in exactly two places."
			}
		},
		"roles": {
			"$description": "What the paint MEANS. ONE group: the site/app split it replaced held six tokens that aliased shared roles under different names and one that differed, which is not a vocabulary, it is a synonym list. A surface that does not use `evidence` simply does not use it. A role prefixed `dark-` is that role's value under `[data-theme=\"dark\"]`: the generator strips the prefix and emits it in the dark block, the same derivation the surfaces use. Only roles that actually differ need one. The `border-strong`/`border-soft`/`track`/`error-surface`/`error-border` roles exist because those values used to be alphas of another colour, which cannot be themed: an alpha carries a RELATIONSHIP to whatever is behind it, and that relationship inverts between a pale ground and a dark one.",
			"background": {
				"$type": "color",
				"$value": "var(--color-surface-page)",
				"$description": "the page ground."
			},
			"foreground": {
				"$type": "color",
				"$value": "var(--color-on-light)",
				"$description": "body copy."
			},
			"muted": {
				"$type": "color",
				"$value": "#f4f4f0",
				"$description": "a quiet fill. Was a color-mix of marine into the page."
			},
			"muted-foreground": {
				"$type": "color",
				"$value": "#7d8593",
				"$description": "quiet copy. WARNING: 3.66:1 on the page ground — this FAILS AA as text and must not be used for any. `foreground-quiet` is the readable step. Kept for non-text uses pending its own fix."
			},
			"border": {
				"$type": "color",
				"$value": "#dfe1e6",
				"$description": "a hairline."
			},
			"input": {
				"$type": "color",

{
	"$description": "avenCEO brand tokens. THE source of truth: the TypeScript package loads this file and adds types, it does not hold values. DTCG shape ($type/$value); values may reference other tokens with var(--color-...) exactly as the emitted CSS does.",
	"name": "avenCEO",
	"slug": "aven-ceo",
	"color": {
		"tones": {
			"marine": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "the brand blue. Also the ground a dark theme stands on."
			},
			"paradise": {
				"$type": "color",
				"$value": "#2489a0",
				"$description": "the deeper blue-teal — work in motion."
			},
			"turquoise": {
				"$type": "color",
				"$value": "#449c94",
				"$description": "the bright turquoise — settled work."
			},
			"sunflower": {
				"$type": "color",
				"$value": "#f2ba3d",
				"$description": "the brand highlight. Sunflower, not \"gold\" — the generic word loses the name."
			},
			"earth": {
				"$type": "color",
				"$value": "#d4a373",
				"$description": "FUNCTIONAL, not identity: the notice tone."
			},
			"terracotta": {
				"$type": "color",
				"$value": "#c15b40",
				"$description": "FUNCTIONAL, not identity: the failure tone. Not in the logo; it means something went wrong."
			},
			"$description": "The brand hues. Identity first, then the two that carry only meaning. Sorted by hue so the family structure is visible rather than incidental."
		},
		"grounds": {
			"$description": "The surface colours themselves, per theme. Separate from `surfaces` on purpose: a component that names a theme cannot be re-themed, so the ladders live here and the rungs live there.",
			"light-page": {
				"$type": "color",
				"$value": "#fffdf7",
				"$description": "was porcelain — the lightest ground, what the page itself stands on."
			},
			"light-raised": {
				"$type": "color",
				"$value": "#faf9f4",
				"$description": "was linen — a region lifted off the page."
			},
			"light-sunken": {
				"$type": "color",
				"$value": "#f6f3e8",
				"$description": "was eggshell — a region set into the page."
			},
			"light-card": {
				"$type": "color",
				"$value": "#f6f1e2",
				"$description": "was ivory — the fill of a card."
			},
			"light-selected": {
				"$type": "color",
				"$value": "#f3e7c6",
				"$description": "was sand — a card the user has chosen."
			},
			"dark-page": {
				"$type": "color",
				"$value": "#1e293b",
				"$description": "the deepest rung. The dark theme is DECLARED here and not yet wired; nothing renders from it until `surfaces` has a dark override."
			},
			"dark-raised": {
				"$type": "color",
				"$value": "#243448",
				"$description": "a region lifted off the dark page. Derived from marine, not yet verified for contrast."
			},
			"dark-card": {
				"$type": "color",
				"$value": "#2a3a56",
				"$description": "the fill of a card on a dark page. Derived, not yet verified."
			},
			"dark-selected": {
				"$type": "color",
				"$value": "#57789e",
				"$description": "was anchor — the mid step of the marine hue."
			},
			"dark-ink": {
				"$type": "color",
				"$value": "#f8fafc",
				"$description": "was chalk — the text that reads on a dark ground."
			}
		},
		"contrastInk": {
			"on-warning": {
				"$type": "color",
				"$value": "#2b2313",
				"$description": "near-black with a warm cast — the only text that reads on sunflower."
			},
			"on-error": {
				"$type": "color",
				"$value": "#fffefb",
				"$description": "near-white with a warm cast — the text that reads on terracotta."
			},
			"on-success": {
				"$type": "color",
				"$value": "#fafaf9",
				"$description": "near-white, neutral — the text that reads on turquoise."
			},
			"on-info": {
				"$type": "color",
				"$value": "#2b231c",
				"$description": "near-black with a warm cast — the text that reads on earth."
			},
			"white": {
				"$type": "color",
				"$value": "#ffffff",
				"$description": "true white. The one place the system uses it, so it is named rather than typed."
			}
		},
		"surfaces": {
			"$description": "What a component actually references, and the theme seam. Theme-NEUTRAL: a component says `bg-card` and never learns which theme it is in, so switching themes re-points these five at the other ladder rather than editing every call site.",
			"surface-page": {
				"$type": "color",
				"$value": "var(--color-light-page)",
				"$description": "the page ground itself."
			},
			"surface-raised": {
				"$type": "color",
				"$value": "var(--color-light-raised)",
				"$description": "lifted off the page."
			},
			"surface-sunken": {
				"$type": "color",
				"$value": "var(--color-light-sunken)",
				"$description": "set into the page. Absorbed `surface-card-hover`."
			},
			"surface-card": {
				"$type": "color",
				"$value": "var(--color-light-card)",
				"$description": "the fill of a card."
			},
			"surface-selected": {
				"$type": "color",
				"$value": "var(--color-light-selected)",
				"$description": "a card the user has chosen."
			}
		},
		"roles": {
			"primary": {
				"$type": "color",
				"$value": "var(--color-marine)"
			},
			"primary-foreground": {
				"$type": "color",
				"$value": "var(--color-dark-ink)"
			},
			"quiet": {
				"$type": "color",
				"$value": "var(--color-dark-selected)"
			},
			"quiet-foreground": {
				"$type": "color",
				"$value": "var(--color-dark-ink)"
			},
			"quiet-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-dark-selected) 82%, black)"
			},
			"progress": {
				"$type": "color",
				"$value": "var(--color-paradise)"
			},
			"progress-foreground": {
				"$type": "color",
				"$value": "var(--color-dark-ink)"
			},
			"progress-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-paradise) 72%, black)"
			},
			"success": {
				"$type": "color",
				"$value": "var(--color-turquoise)"
			},
			"success-foreground": {
				"$type": "color",
				"$value": "var(--color-on-success)"
			},
			"success-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-turquoise) 68%, black)"
			},
			"warning": {
				"$type": "color",
				"$value": "var(--color-sunflower)"
			},
			"warning-foreground": {
				"$type": "color",
				"$value": "var(--color-on-warning)"
			},
			"warning-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-sunflower) 62%, black)"
			},
			"error": {
				"$type": "color",
				"$value": "var(--color-terracotta)"
			},
			"error-foreground": {
				"$type": "color",
				"$value": "var(--color-on-error)"
			},
			"error-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-terracotta) 85%, black)"
			},
			"info": {
				"$type": "color",
				"$value": "var(--color-earth)"
			},
			"info-foreground": {
				"$type": "color",
				"$value": "var(--color-on-info)"
			},
			"info-ink": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-earth) 72%, black)"
			},
			"secondary": {
				"$type": "color",
				"$value": "var(--color-light-selected)"
			},
			"secondary-foreground": {
				"$type": "color",
				"$value": "var(--color-marine)"
			},
			"foreground": {
				"$type": "color",
				"$value": "var(--color-marine)"
			},
			"card-foreground": {
				"$type": "color",
				"$value": "var(--color-foreground)"
			},
			"muted": {
				"$type": "color",
				"$value": "color-mix(in srgb, var(--color-marine) 6%, var(--color-surface-page))"
			},
			"muted-foreground": {
				"$type": "color",
				"$value": "color-mix(in srgb, var(--color-marine) 42%, transparent)"
			},
			"border": {
				"$type": "color",
				"$value": "color-mix(in srgb, var(--color-marine) 14%, transparent)"
			},
			"input": {
				"$type": "color",
				"$value": "color-mix(in srgb, var(--color-white) 65%, var(--color-surface-page))"
			}
		},
		"siteRoles": {
			"$description": "Roles only the marketing site owns. Each ALIASES the shared role that already carries the value — the site means \"highlight\" where the app means \"careful\", which is a real difference in meaning and not a reason to derive the colour twice. Changing the gold is now one edit, not three.",
			"accent": {
				"$type": "color",
				"$value": "var(--color-warning)",
				"$description": "the marketing highlight. Same paint as `warning`; different job."
			},
			"accent-foreground": {
				"$type": "color",
				"$value": "var(--color-warning-foreground)",
				"$description": "text on the accent."
			},
			"accent-ink": {
				"$type": "color",
				"$value": "var(--color-warning-ink)",
				"$description": "the accent as running text."
			},
			"offer": {
				"$type": "color",
				"$value": "var(--color-error)",
				"$description": "the BETA window, which closes. Borrows the failure tone deliberately so an offer never reads as merely a highlight."
			},
			"offer-foreground": {
				"$type": "color",
				"$value": "var(--color-error-foreground)",
				"$description": "text on an offer."
			},
			"offer-ink": {
				"$type": "color",
				"$value": "var(--color-error-ink)",
				"$description": "the offer as running text."
			},
			"card": {
				"$type": "color",
				"$value": "var(--color-surface-raised)",
				"$description": "the site puts cards on the raised rung rather than the card rung."
			}
		},
		"appRoles": {
			"error-muted": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-terracotta) 22%, white)"
			},
			"error-strong": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-terracotta) 78%, black)"
			},
			"success-muted": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-turquoise) 22%, white)"
			},
			"success-strong": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-turquoise) 78%, black)"
			},
			"warning-muted": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-sunflower) 22%, white)"
			},
			"warning-strong": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-sunflower) 78%, black)"
			},
			"info-muted": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-earth) 22%, white)"
			},
			"info-strong": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-earth) 78%, black)"
			},
			"evidence": {
				"$type": "color",
				"$value": "var(--color-warning)",
				"$description": "the grounding marker. Same paint as `warning`; different job."
			},
			"evidence-soft": {
				"$type": "color",
				"$value": "color-mix(in oklab, var(--color-sunflower) 26%, white)"
			},
			"evidence-ink": {
				"$type": "color",
				"$value": "var(--color-warning-ink)",
				"$description": "the grounding marker. Same paint as `warning-ink`; different job."
			},
			"card": {
				"$type": "color",
				"$value": "var(--color-white)"
			},
			"sandbox-host": {
				"$type": "color",
				"$value": "color-mix(in srgb, var(--color-surface-page) 94%, var(--color-foreground))"
			}
		}
	},
	"font": {
		"stack": {
			"app": {
				"$type": "fontFamily",

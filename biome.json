{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/bun.lock",
			"!!**/*.svg",
			"// Every brand's kitchen sink is GENERATED from its definition by",
			"// `bun run guidelines` — they document the system rather than being",
			"// authored, and formatting one by hand would be undone on the next run.",
			"!!**/kitchen-sink.html",
			"// Likewise the brand stylesheets. Their shape comes from a brand",
			"// definition and the generator's rules — a stylistic complaint about",
			"// one is a complaint about the generator, and fixing it in the output",
			"// would survive exactly until the next `bun run build:packages`.",
			"!!**/brand-theme.css",
			"!!**/brand-components.css",
			"!!**/brand-elements.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"trailingCommas": "none"
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"lineWidth": 100
		},
		"linter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["**/app.css"],
			"linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } }
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedFunctionParameters": "off"
					},
					"suspicious": {
						"noGlobalAssign": "off"
					},
					"a11y": "off"
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
